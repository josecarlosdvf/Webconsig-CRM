# Backend Configuration
APP_ENV=development
APP_API_VERSION=v1
APP_DATABASE_URL=postgresql+asyncpg://postgres:Ti123!@#@localhost:5433/webconsig
APP_JWT_SECRET=change-me-in-production
APP_JWT_EXPIRES_IN=3600
APP_TENANT_HEADER=X-Tenant-Id
APP_WEBHOOK_SECRET=change-me-in-production
APP_ENABLE_TLS=false

# Password Policy
APP_PASSWORD_MIN_LENGTH=8
APP_PASSWORD_REQUIRE_UPPERCASE=true
APP_PASSWORD_REQUIRE_LOWERCASE=true
APP_PASSWORD_REQUIRE_DIGIT=true
APP_PASSWORD_REQUIRE_SPECIAL=true

# CORS Configuration
# Use "*" for allow all (development only), or specify comma-separated origins for production
# Examples: 
#   APP_CORS_ALLOWED_ORIGINS=*
#   APP_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
APP_CORS_ALLOWED_ORIGINS=*
APP_CORS_ALLOW_CREDENTIALS=true
# Use "*" or specific methods (GET,POST,PUT,PATCH,DELETE,OPTIONS)
APP_CORS_ALLOW_METHODS=*
# Use "*" or specific headers (authorization,content-type,x-tenant-id)
APP_CORS_ALLOW_HEADERS=*
